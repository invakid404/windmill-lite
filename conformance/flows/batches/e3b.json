{
  "batch": "E3b",
  "row": "Recording batch FX core: FX-6 to FX-10 and FX-16 to FX-21, with the contested FX-10 route cases that need no handler and FX-42/h",
  "about": "Every case of the batch, the oracle runs that record it, and the milestone whose exit gate runs it. A catalogue case is named by its id; a case that encodes a finding's rule beyond its catalogue cases is named by the finding id and a variant. A case gates N1a unless its flow needs a feature that a later milestone implements: continue_on_error, the failure module, error shapes and chaining errors (N1b), retry or sleep (N2), branches (N3b), a platform provider (PF2), as ADR 0012 assigns E3a's cases. A case that needs two of these from milestones neither of which depends on the other gates the first milestone that needs both: NI for N1b with N2, and F1 for N2 with PF2, which is where ADR 0012 puts E3a's JE-V2/b. TestRecordingBatches in internal/oracle checks this file against the catalogue, the fixtures and the committed recordings.",
  "scope": {
    "findings": ["FX-6", "FX-7", "FX-8", "FX-9", "FX-10", "FX-16", "FX-17", "FX-18", "FX-19", "FX-20", "FX-21"],
    "cases": ["FX-42/h"]
  },
  "cases": [
    {"case": "FX-6/a", "runs": ["execution/fx-6/first_step"], "gate": "N1a"},
    {"case": "FX-6/b", "runs": ["execution/fx-6/after_tolerated"], "gate": "N1b"},
    {"case": "FX-6", "variant": "re-derived previous result after a tolerated failure", "runs": ["execution/fx-6/rederived_on_retry"], "gate": "NI"},

    {"case": "FX-7/a", "runs": ["execution/fx-7/js_and_static"], "gate": "N1a"},
    {"case": "FX-7/b", "runs": ["execution/fx-7/params_and_undefined"], "gate": "N1a"},
    {"case": "FX-7/c", "runs": ["execution/fx-7/params_and_undefined"], "gate": "N1a"},
    {"case": "FX-7/d", "runs": ["execution/fx-7/result_unbound"], "gate": "N1b"},

    {"case": "FX-8/a", "runs": ["execution/fx-8/stop_scope"], "gate": "N1a"},
    {"case": "FX-8/b", "runs": ["execution/fx-8/sleep_no_results"], "gate": "NI"},

    {"case": "FX-9/a", "runs": ["execution/fx-9/values"], "gate": "N1a"},
    {"case": "FX-9/b", "runs": ["execution/fx-9/values"], "gate": "N1a"},

    {"case": "FX-10/a", "runs": ["execution/fx-10/handler_reads"], "gate": "N1b"},
    {"case": "FX-10/b", "runs": ["execution/fx-10/unknown_id"], "gate": "N1a"},
    {"case": "FX-10", "variant": "engine reads of the preceding id without a failure module (Q-FX-15)", "runs": ["execution/fx-10/memory_or_storage"], "gate": "N1a"},

    {"case": "FX-16/a", "runs": ["execution/fx-16/direct_input"], "gate": "N1a"},
    {"case": "FX-16/b", "runs": ["execution/fx-16/passthrough"], "gate": "N1a"},

    {"case": "FX-17/a", "runs": ["execution/fx-17/skip_passthrough"], "gate": "N1a"},
    {"case": "FX-17/b", "runs": ["execution/fx-17/skip_on_retry"], "gate": "F1"},
    {"case": "FX-17", "variant": "a skipped step's stop_after_if is not evaluated", "runs": ["execution/fx-17/skip_last_no_stop"], "gate": "N1a"},

    {"case": "FX-18/a", "runs": ["execution/fx-18/mocked"], "gate": "N1a"},
    {"case": "FX-18", "variant": "stop_after_if on the mock value, and a false skip_if beside a mock", "runs": ["execution/fx-18/mock_stop", "execution/fx-18/mock_skip_false"], "gate": "N1a"},

    {"case": "FX-19/a", "runs": ["execution/fx-19/clean_skipped"], "gate": "N1a"},
    {"case": "FX-19/b", "runs": ["execution/fx-19/error_include"], "gate": "N1a"},
    {"case": "FX-19/c", "runs": ["execution/fx-19/empty_message"], "gate": "N1a"},
    {"case": "FX-19/d", "runs": ["execution/fx-19/retry_then_handler"], "gate": "NI"},
    {"case": "FX-19/e", "runs": ["execution/fx-19/tolerated_next"], "gate": "N1b"},
    {"case": "FX-19/f", "runs": ["execution/fx-19/tolerated_last"], "gate": "N1b"},
    {"case": "FX-19/g", "runs": ["execution/fx-19/tolerated_next_no_handler"], "gate": "N1b"},
    {"case": "FX-19/h", "runs": ["execution/fx-19/retry_no_handler"], "gate": "N2"},
    {"case": "FX-19/i", "runs": ["execution/fx-19/tolerated_last_handler"], "gate": "N1b"},
    {"case": "FX-19", "variant": "the clean stop without skip_if_stopped, and skip_if_stopped winning over error_message", "runs": ["execution/fx-19/clean_success", "execution/fx-19/skipped_wins"], "gate": "N1a"},

    {"case": "FX-20/a", "runs": ["execution/fx-20/branch_stop"], "gate": "N3b"},
