    {"case": "FX-21", "variant": "a throwing stop_after_if still enters the failure module", "runs": ["execution/fx-21/throwing_stop_handler"], "gate": "N1b"},

    {"case": "FX-42/h", "runs": ["execution/fx-42/args_file", "execution/fx-42/javascript"], "gate": "PF2"}
  ]
