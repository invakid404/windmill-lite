{
  "finding": "SY-1",
  "cases": [
    {
      "spec": "SY-1/a",
      "provenance": "source-derived",
      "title": "flat script",
      "given": {
        "files": {
          "wmill.yaml": "defaultTs: bun\n",
          "f/a/hello.ts": "export async function main() {\n  return 1;\n}\n",
          "f/a/hello.script.yaml": "summary: hello\n"
        }
      },
      "expect": {
        "paths": {
          "script": [
            "f/a/hello"
          ]
        },
        "items": {
          "script": {
            "f/a/hello": {
              "at": {
                "/file": "f/a/hello.ts",
                "/metadata_file": "f/a/hello.script.yaml",
                "/language": "bun",
                "/metadata/summary": "hello"
              }
            }
          }
        }
      }
    },
    {
      "spec": "SY-1/b",
      "provenance": "source-derived",
      "policy": "ADR 0002: a script file the CLI would rename by cutting its path at the first dot is refused",
      "note": "Windmill path f/my; windmill-lite refuses the file instead of renaming the script",
      "title": "dotted folder truncates",
      "given": {
        "files": {
          "wmill.yaml": "defaultTs: bun\n",
          "f/my.dir/x.ts": "export async function main() {\n  return 1;\n}\n"
        }
      },
      "expect": {
        "paths": {
          "script": [
            "f/my"
          ]
        },
        "items": {
          "script": {
            "f/my": {
              "error": {
                "kind": "dotted_path",
                "contains": [
                  "f/my.dir/x.ts",
                  "f/my"
                ]
              }
            },
            "f/my.dir/x": {
              "error": {
                "kind": "not_in_folder",
                "contains": [
                  "f/my.dir/x.ts"
                ]
              }
            }
          }
        },
        "warnings": [
          "dotted script paths"
        ],
        "check_error": {
          "kind": "dotted_path"
        }
      }
    },
    {
      "spec": "SY-1/b",
      "variant": "flow-and-resource",
      "provenance": "source-derived",
      "note": "SY-1 applies the first-dot rule to flat script files only; folder markers and type suffixes are stripped",
      "title": "a dot in a flow or resource path is kept",
      "given": {
        "files": {
          "wmill.yaml": "defaultTs: bun\n",
          "f/my.dir/x.flow/flow.yaml": "summary: one step\nvalue:\n  modules:\n    - id: a\n      value:\n        type: identity\n",
          "f/my.dir/cfg.resource.yaml": "resource_type: x\nvalue: 1\n"
        }
      },
      "expect": {
        "paths": {
          "flow": [
            "f/my.dir/x"
          ],
          "resource": [
            "f/my.dir/cfg"
          ],
          "script": []
        },
        "items": {
          "flow": {
            "f/my.dir/x": {
              "at": {
                "/dir": "f/my.dir/x.flow"
              }
            }
          },
          "resource": {
            "f/my.dir/cfg": {
              "at": {
                "/value": 1
              }
            }
          }
        },
        "check_ok": true
      }
    },
    {
      "spec": "SY-1/c",
      "provenance": "source-derived",
      "title": "dot directory skipped",
      "given": {
        "files": {
          "wmill.yaml": "defaultTs: bun\n",
          ".git/x.ts": "export async function main() {\n  return 1;\n}\n",
          "f/a/.cache/x.ts": "export async function main() {\n  return 1;\n}\n",
          "f/a/ok.ts": "export async function main() {\n  return 1;\n}\n"
        }
      },
      "expect": {
        "paths": {
          "script": [
            "f/a/ok"
          ]
        },
        "check_ok": true
      }
    },
    {
      "spec": "SY-1/d",
      "provenance": "source-derived",
      "title": "node_modules skipped",
      "given": {
        "files": {
          "wmill.yaml": "defaultTs: bun\n",
          "node_modules/a/b.ts": "export async function main() {\n  return 1;\n}\n",
          "f/a/node_modules/b/c.ts": "export async function main() {\n  return 1;\n}\n",
          "f/a/ok.ts": "export async function main() {\n  return 1;\n}\n"
        }
      },
      "expect": {
        "paths": {
          "script": [
            "f/a/ok"
          ]
        },
        "check_ok": true
      }
    },
    {
      "spec": "SY-1/e",
      "variant": "bun.ts",
      "provenance": "source-derived",
      "title": "multi-part language suffix .bun.ts",
      "given": {
        "files": {
          "wmill.yaml": "defaultTs: bun\n",
          "f/a/x.bun.ts": "export async function main() {\n  return 1;\n}\n"
        }
      },
      "expect": {
