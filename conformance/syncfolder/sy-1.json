              }
            }
          }
        }
      }
    },
    {
      "spec": "SY-1/e",
      "variant": "fetch.ts",
      "provenance": "source-derived",
      "title": "multi-part language suffix .fetch.ts",
      "given": {
        "files": {
          "wmill.yaml": "defaultTs: bun\n",
          "f/a/x.fetch.ts": "export async function main() {\n  return 1;\n}\n"
