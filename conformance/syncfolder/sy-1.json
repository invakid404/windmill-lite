    {
      "spec": "SY-1/f",
      "provenance": "source-derived",
      "scope": "later",
      "policy": "ADR 0002: the root is always the directory of wmill.yaml",
      "note": "the CLI finds the parent's config and keeps the child as its working directory; windmill-lite walks the parent and says so",
      "title": "noCdToRoot: true",
      "given": {
        "files": {
          "wmill.yaml": "defaultTs: bun\nnoCdToRoot: true\n",
          "sub/README.md": "child\n"
        },
        "start": "sub"
      },
      "expect": {
        "root": ".",
        "warnings": [
          "noCdToRoot",
          "SY-V4"
        ]
      }
    },
    {
      "spec": "SY-1/g",
      "provenance": "source-derived",
      "scope": "later",
      "title": "noCdToRoot: false",
      "given": {
        "files": {
          "wmill.yaml": "defaultTs: bun\nnoCdToRoot: false\n",
          "sub/README.md": "child\n"
        },
        "start": "sub"
      },
      "expect": {
        "root": ".",
        "not_warnings": [
          "noCdToRoot"
        ]
      }
    },
    {
      "spec": "SY-1",
      "provenance": "source-derived",
      "title": "upward search stops at the git root",
      "given": {
        "files": {
          "wmill.yaml": "defaultTs: bun\n",
          "repo/.git/HEAD": "ref: x\n",
          "repo/f/a/x.ts": "export async function main() {\n  return 1;\n}\n"
        },
        "start": "repo"
      },
      "expect": {
        "load": {
          "kind": "wmill_yaml_not_found"
        }
      }
    },
    {
      "spec": "SY-1",
      "provenance": "source-derived",
      "title": "the git root itself is searched",
      "given": {
        "files": {
          "repo/.git/HEAD": "ref: x\n",
          "repo/wmill.yaml": "defaultTs: bun\n",
          "repo/f/a/x.ts": "export async function main() {\n  return 1;\n}\n"
        },
        "start": "repo/f/a"
      },
      "expect": {
        "root": "repo",
        "paths": {
          "script": [
            "f/a/x"
          ]
        }
      }
    },
    {
      "spec": "SY-1",
      "provenance": "source-derived",
      "title": "paths outside u/, f/ and g/ are ignored",
      "given": {
        "files": {
          "wmill.yaml": "defaultTs: bun\n",
          "x.ts": "export async function main() {\n  return 1;\n}\n",
          "lib/y.ts": "export async function main() {\n  return 1;\n}\n",
          "f/x.ts": "export async function main() {\n  return 1;\n}\n",
          "u/me/y.ts": "export async function main() {\n  return 1;\n}\n",
          "g/team/z.ts": "export async function main() {\n  return 1;\n}\n"
        }
      },
      "expect": {
        "paths": {
          "script": [
            "f/x",
            "g/team/z",
            "u/me/y"
          ]
        }
      }
    },
    {
      "spec": "SY-1",
      "provenance": "source-derived",
      "policy": "ADR 0002: a script file the CLI would rename by cutting its path at the first dot is refused",
      "title": "first-dot rule on a file name",
      "given": {
        "files": {
          "wmill.yaml": "defaultTs: bun\n",
          "f/a/types.d.ts": "export async function main() {\n  return 1;\n}\n",
          "f/a/my.script.ts": "export async function main() {\n  return 1;\n}\n"
        }
      },
      "expect": {
        "paths": {
          "script": [
            "f/a/my",
            "f/a/types"
          ]
        },
        "items": {
          "script": {
            "f/a/types": {
              "error": {
                "kind": "dotted_path",
                "contains": [
                  "f/a/types.d.ts"
                ]
              }
            },
            "f/a/my": {
              "error": {
                "kind": "dotted_path",
                "contains": [
                  "f/a/my.script.ts"
                ]
              }
            }
          }
        }
      }
    },
    {
      "spec": "SY-1",
      "provenance": "source-derived",
      "title": ".wmillignore is ignored",
      "given": {
        "files": {
          "wmill.yaml": "defaultTs: bun\n",
          ".wmillignore": "f/**\n",
          "f/a/x.ts": "export async function main() {\n  return 1;\n}\n"
        }
      },
      "expect": {
        "paths": {
          "script": [
            "f/a/x"
          ]
        },
        "skipped": [
          {
            "file": ".wmillignore",
            "kind": "wmillignore"
          }
        ]
      }
    }
  ]
}
