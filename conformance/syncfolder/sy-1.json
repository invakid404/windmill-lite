    {
      "spec": "SY-1/e",
      "variant": "pg.sql",
      "provenance": "source-derived",
      "title": "multi-part language suffix .pg.sql",
      "given": {
        "files": {
          "wmill.yaml": "defaultTs: bun\n",
          "f/a/x.pg.sql": "select 1;\n"
        }
