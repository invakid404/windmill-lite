    {
      "spec": "SY-17",
      "provenance": "source-derived",
      "title": "a resource is selected by its .resource.yaml, a script by its source",
      "given": {
        "files": {
          "wmill.yaml": "defaultTs: bun\nincludes: ['**/*.json', '**/*.script.yaml']\n",
          "f/a/r.resource.yaml": "resource_type: x\nvalue: 1\n",
          "f/a/r.resource.file.json": "{}\n",
          "f/a/x.ts": "export async function main() {\n  return 1;\n}\n",
          "f/a/x.script.yaml": "summary: s\n"
        }
      },
      "expect": {
        "paths": {
          "resource": [],
          "script": []
        },
        "filtered": {
          "resource": [
            "f/a/r"
          ],
          "script": [
            "f/a/x"
          ]
        }
