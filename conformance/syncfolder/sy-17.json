{
  "finding": "SY-17",
  "cases": [
    {
      "spec": "SY-17/a",
      "variant": "ts",
      "provenance": "source-derived",
      "title": "which files select a script and a flow: **/*.ts",
      "given": {
        "files": {
          "wmill.yaml": "defaultTs: bun\nincludes: ['**/*.ts']\n",
          "f/a/x.ts": "export async function main() {\n  return 1;\n}\n",
          "f/a/x.script.yaml": "summary: s\n",
          "f/a/fl.flow/flow.yaml": "value:\n  modules:\n    - id: a\n      value:\n        type: rawscript\n        language: bun\n        content: '!inline a.inline_script.ts'\n        lock: '!inline a.inline_script.lock'\n        input_transforms: {}\n",
          "f/a/fl.flow/a.inline_script.ts": "export async function main() {\n  return 1;\n}\n"
        }
      },
      "expect": {
        "paths": {
          "script": [
            "f/a/x"
          ],
          "flow": [
            "f/a/fl"
          ]
        },
        "items": {
          "script": {
            "f/a/x": {
              "at": {
                "/metadata/summary": "s",
                "/metadata_file": "f/a/x.script.yaml"
              }
            }
          },
          "flow": {
            "f/a/fl": {
              "at": {
                "/file": "f/a/fl.flow/flow.yaml",
                "/flow/value/modules/0/value/content": "export async function main() {\n  return 1;\n}\n"
              }
            }
          }
        },
        "check_ok": true
      }
    },
    {
      "spec": "SY-17/a",
      "variant": "yaml",
      "provenance": "source-derived",
      "title": "which files select a script and a flow: **/*.yaml",
      "note": "x.script.yaml passes but never selects its script",
      "given": {
        "files": {
          "wmill.yaml": "defaultTs: bun\nincludes: ['**/*.yaml']\n",
          "f/a/x.ts": "export async function main() {\n  return 1;\n}\n",
          "f/a/x.script.yaml": "summary: s\n",
          "f/a/fl.flow/flow.yaml": "value:\n  modules:\n    - id: a\n      value:\n        type: rawscript\n        language: bun\n        content: '!inline a.inline_script.ts'\n        lock: '!inline a.inline_script.lock'\n        input_transforms: {}\n",
          "f/a/fl.flow/a.inline_script.ts": "export async function main() {\n  return 1;\n}\n"
        }
      },
      "expect": {
        "paths": {
          "script": [],
          "flow": [
            "f/a/fl"
          ]
        },
        "filtered": {
          "script": [
            "f/a/x"
          ]
        },
        "items": {
          "flow": {
            "f/a/fl": {
              "at": {
                "/flow/value/modules/0/value/content": "export async function main() {\n  return 1;\n}\n"
              }
            }
          }
        },
        "check_ok": true
      }
    },
    {
      "spec": "SY-17/b",
      "provenance": "source-derived",
      "title": "a new lock file selects nothing",
      "given": {
        "files": {
          "wmill.yaml": "defaultTs: bun\nincludes: ['**/*.lock']\n",
          "f/a/fl.flow/flow.yaml": "value:\n  modules:\n    - id: a\n      value:\n        type: rawscript\n        language: bun\n        content: '!inline a.inline_script.ts'\n        lock: '!inline a.inline_script.lock'\n        input_transforms: {}\n",
          "f/a/fl.flow/a.inline_script.ts": "export async function main() {\n  return 1;\n}\n",
          "f/a/fl.flow/a.inline_script.lock": "{}\n"
        }
      },
      "expect": {
        "paths": {
          "flow": []
        },
        "filtered": {
          "flow": [
            "f/a/fl"
          ]
        },
        "items": {
          "flow": {
            "f/a/fl": {
              "error": {
                "kind": "filtered",
                "contains": [
                  "no file of the flow folder passes the path filter"
                ]
              }
            }
          }
        },
        "check_ok": true
      }
    },
