{
  "finding": "SY-8",
  "cases": [
    {
      "spec": "SY-8/a",
      "provenance": "source-derived",
      "title": "first match wins",
      "given": {
        "files": {
          "wmill.yaml": "defaultTs: bun\ncodebases:\n  - relative_path: ../lib\n    includes: ['f/a/**']\n  - relative_path: ../shared\n",
          "f/a/x.ts": "export async function main() {\n  return 1;\n}\n",
          "f/b/y.ts": "export async function main() {\n  return 1;\n}\n",
          "f/a/z.py": "def main():\n    pass\n"
        }
      },
      "expect": {
        "items": {
          "script": {
            "f/a/x": {
              "at": {
                "/codebase/index": 0,
                "/codebase/relative_path": "../lib"
              }
            },
            "f/b/y": {
              "at": {
                "/codebase/index": 1,
                "/codebase/relative_path": "../shared"
              }
            },
            "f/a/z": {
              "at": {
                "/codebase": null
              }
            }
          }
        }
      }
    },
    {
      "spec": "SY-8/b",
      "provenance": "source-derived",
      "title": "Bun-only bundling",
      "given": {
        "files": {
          "wmill.yaml": "defaultTs: bun\ncodebases:\n  - relative_path: ../lib\n",
          "f/a/x.ts": "export async function main() {\n  return 1;\n}\n",
          "f/a/y.deno.ts": "export async function main() {\n  return 1;\n}\n",
          "f/a/z.fetch.ts": "export async function main() {\n  return 1;\n}\n"
        }
      },
      "expect": {
        "items": {
          "script": {
            "f/a/x": {
              "at": {
                "/codebase/index": 0
              }
            },
            "f/a/y": {
              "at": {
                "/codebase": null
              }
            },
            "f/a/z": {
              "at": {
                "/codebase": null
              }
            }
          }
        }
      }
    },
    {
      "spec": "SY-8/c",
      "provenance": "source-derived",
      "title": "includes: [] never matches",
      "given": {
        "files": {
          "wmill.yaml": "defaultTs: bun\ncodebases:\n  - relative_path: ../lib\n    includes: []\n  - relative_path: ../shared\n",
          "f/a/x.ts": "export async function main() {\n  return 1;\n}\n"
        }
      },
      "expect": {
        "items": {
