            "f/a/x": {
              "at": {
                "/codebase/index": 1,
                "/codebase/relative_path": "../shared"
              }
            }
          }
        }
      }
    },
    {
      "spec": "SY-8",
      "provenance": "source-derived",
      "title": "an exclude vetoes the only entry",
      "given": {
        "files": {
          "wmill.yaml": "defaultTs: bun\ncodebases:\n  - relative_path: ./lib\n    includes: ['**/*.ts']\n    excludes: ['f/b/**']\n",
          "f/a/x.ts": "export async function main() {\n  return 1;\n}\n",
          "f/b/y.ts": "export async function main() {\n  return 1;\n}\n"
        }
      },
      "expect": {
        "items": {
          "script": {
            "f/a/x": {
              "at": {
                "/codebase/index": 0
              }
            },
            "f/b/y": {
              "at": {
                "/codebase": null
              }
            }
          }
        }
      }
    },
    {
      "spec": "SY-8",
      "provenance": "source-derived",
