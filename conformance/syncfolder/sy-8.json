    {
      "spec": "SY-8",
      "provenance": "source-derived",
      "title": "the entry's settings are kept for the bundler",
      "given": {
        "files": {
          "wmill.yaml": "defaultTs: bun\ncodebases:\n  - relative_path: ../lib\n    format: esm\n    external: [pg]\n    assets: [{from: a.txt, to: b.txt}]\n",
