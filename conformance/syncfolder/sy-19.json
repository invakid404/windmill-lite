{
  "finding": "SY-19",
  "cases": [
    {
      "spec": "SY-19/a",
      "provenance": "source-derived",
      "title": "UTF-8 byte order mark",
      "given": {
        "files": {
          "wmill.yaml": "defaultTs: bun\n",
          "f/a/x.ts": "﻿export function main() { return 1 }\n"
        }
      },
      "expect": {
        "items": {
          "script": {
            "f/a/x": {
              "at": {
                "/content": "export function main() { return 1 }\n"
              }
            }
          }
        },
        "check_ok": true
      }
    },
    {
      "spec": "SY-19/b",
      "provenance": "source-derived",
      "title": "UTF-16 byte order mark",
      "given": {
        "files": {
          "wmill.yaml": "defaultTs: bun\n"
        },
        "hex_files": {
          "f/a/x.ts": "fffe6500780070006f00720074002000660075006e006300740069006f006e0020006d00610069006e002800290020007b002000720065007400750072006e002000310020007d000a00"
        }
      },
      "expect": {
        "paths": {
          "script": [
            "f/a/x"
          ]
        },
        "items": {
          "script": {
            "f/a/x": {
              "error": {
                "kind": "invalid_text",
                "contains": [
                  "File f/a/x.ts is encoded as UTF-16 LE, which is not supported. Please convert it to UTF-8."
                ]
              }
            }
          }
        },
        "check_error": {
          "kind": "invalid_text",
          "contains": [
            "File f/a/x.ts is encoded as UTF-16 LE, which is not supported. Please convert it to UTF-8."
          ]
        }
      }
    },
    {
      "spec": "SY-19/c",
      "provenance": "source-derived",
      "title": "a refused lock reached only as a reference",
      "given": {
        "files": {
          "wmill.yaml": "defaultTs: bun\nincludes: ['**/*.ts']\n",
          "f/a/x.ts": "export function main() { return 1 }\n",
          "f/a/x.script.yaml": "lock: '!inline f/a/x.script.lock'\n"
        },
        "hex_files": {
          "f/a/x.script.lock": "fffe7b007d000a00"
        }
      },
      "expect": {
        "items": {
          "script": {
            "f/a/x": {
              "at": {
                "/lock": "",
                "/warnings": [
                  "Error reading inline path: f/a/x.script.lock, Error: File f/a/x.script.lock is encoded as UTF-16 LE, which is not supported. Please convert it to UTF-8."
                ]
              },
              "absent": [
                "/lock_file"
              ]
            }
          }
        },
        "check_ok": true
      }
    },
