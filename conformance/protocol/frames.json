  "relies_on": [
    "WR-15",
    "WR-23"
  ],
  "note": "Written by `go test ./internal/harness -run TestFrameCases -update`; payload and frames are the Go encoder's output. Both the Go codec and the Bun harness's codec (harnesses/bun/test) run every case unless `sides` limits it.",
  "cases": [
    {
      "case": "hello",
      "title": "the harness's first frame",
      "message": {
        "t": "hello",
        "proto": 1,
        "harness": {
          "kind": "bun",
          "version": "0.0.0-c1"
        },
        "runtime": "1.3.10",
        "caps": {
          "fetch": false,
          "native": false,
          "fresh": false,
          "host": false
        },
        "bundle": "sha256:00ff",
        "pid": 4242
      },
      "payload": "{\"t\":\"hello\",\"proto\":1,\"harness\":{\"kind\":\"bun\",\"version\":\"0.0.0-c1\"},\"runtime\":\"1.3.10\",\"caps\":{\"fetch\":false,\"native\":false,\"fresh\":false,\"host\":false},\"bundle\":\"sha256:00ff\",\"pid\":4242}"
    },
    {
      "case": "welcome-config",
