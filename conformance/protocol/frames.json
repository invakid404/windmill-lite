    },
    {
      "case": "raw-args-kept",
      "title": "raw values keep their bytes: whitespace, key order, number spelling",
      "sides": [
        "go"
      ],
      "message_text": "{\"t\":\"invoke\",\"id\":\"i3\",\"run\":\"r1\",\"site\":\"m:a\",\"script\":\"echo\",\"entry\":\"main\",\"args\":{\"b\" : 1, \"1\": 2.50, \"a\":1e2},\"env\":{},\"boundary\":\"bun\"}",
      "raw": {
        "args": "{\"b\" : 1, \"1\": 2.50, \"a\":1e2}"
      },
      "payload": "{\"t\":\"invoke\",\"id\":\"i3\",\"run\":\"r1\",\"site\":\"m:a\",\"script\":\"echo\",\"entry\":\"main\",\"args\":{\"b\" : 1, \"1\": 2.50, \"a\":1e2},\"env\":{},\"boundary\":\"bun\"}"
    },
    {
      "case": "keys-exact",
      "title": "keys match exactly: other spellings are unknown fields",
