        "engine": "(devel)",
        "bundle": "sha256:00ff",
        "config": {
          "module_state": "warm",
          "heartbeat_ms": 1000,
          "max_message": 536870912
        }
      },
      "payload": "{\"t\":\"welcome\",\"proto\":1,\"engine\":\"(devel)\",\"bundle\":\"sha256:00ff\",\"config\":{\"module_state\":\"warm\",\"heartbeat_ms\":1000,\"max_message\":536870912}}"
