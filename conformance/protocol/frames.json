      "payload": "{\"t\":\"result\",\"id\":\"i1\",\"outcome\":\"ok\",\"body\":1,\"settled\":true}"
    },
    {
      "case": "split-result",
      "title": "a message longer than the frame limit goes as a part stream",
      "message": {
        "t": "result",
        "id": "i1",
        "outcome": "ok",
        "body": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "settled": true
      },
      "split": {
        "stream": "1",
        "chunk_bytes": 16
      },
      "payload": "{\"t\":\"result\",\"id\":\"i1\",\"outcome\":\"ok\",\"body\":\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\",\"settled\":true}",
      "frames": [
        "{\"t\":\"part\",\"id\":\"1\",\"seq\":0,\"last\":false,\"chunk\":\"eyJ0IjoicmVzdWx0IiwiaQ==\"}",
        "{\"t\":\"part\",\"id\":\"1\",\"seq\":1,\"last\":false,\"chunk\":\"ZCI6ImkxIiwib3V0Y29tZQ==\"}",
        "{\"t\":\"part\",\"id\":\"1\",\"seq\":2,\"last\":false,\"chunk\":\"Ijoib2siLCJib2R5IjoieA==\"}",
        "{\"t\":\"part\",\"id\":\"1\",\"seq\":3,\"last\":false,\"chunk\":\"eHh4eHh4eHh4eHh4eHh4eA==\"}",
        "{\"t\":\"part\",\"id\":\"1\",\"seq\":4,\"last\":false,\"chunk\":\"eHh4eHh4eHh4eHh4eCIsIg==\"}",
        "{\"t\":\"part\",\"id\":\"1\",\"seq\":5,\"last\":true,\"chunk\":\"c2V0dGxlZCI6dHJ1ZX0=\"}"
      ]
    },
