{
  "level": "protocol",
  "title": "Frame codec golden frames of the harness protocol",
  "design": "docs/design/0004-harness-protocol.md#transport-and-framing",
  "provenance": "policy",
  "relies_on": [
    "WR-15",
    "WR-23"
  ],
  "note": "Written by `go test ./internal/harness -run TestFrameCases -update`; payload and frames are the Go encoder's output. Both the Go codec and the Bun harness's codec (harnesses/bun/test) run every case unless `sides` limits it.",
  "cases": [
    {
      "case": "hello",
      "title": "the harness's first frame",
      "message": {
        "t": "hello",
        "proto": 1,
        "harness": {
          "kind": "bun",
          "version": "0.0.0-c1"
        },
        "runtime": "1.3.10",
        "caps": {
          "fetch": false,
          "native": false,
          "fresh": false,
          "host": false
        },
        "bundle": "sha256:00ff",
        "pid": 4242
      },
      "payload": "{\"t\":\"hello\",\"proto\":1,\"harness\":{\"kind\":\"bun\",\"version\":\"0.0.0-c1\"},\"runtime\":\"1.3.10\",\"caps\":{\"fetch\":false,\"native\":false,\"fresh\":false,\"host\":false},\"bundle\":\"sha256:00ff\",\"pid\":4242}"
    },
    {
      "case": "welcome-config",
      "title": "the engine accepts a harness",
      "message": {
        "t": "welcome",
        "proto": 1,
        "engine": "(devel)",
        "bundle": "sha256:00ff",
        "config": {
          "module_state": "warm",
          "heartbeat_ms": 1000,
          "max_message": 536870912
        }
      },
      "payload": "{\"t\":\"welcome\",\"proto\":1,\"engine\":\"(devel)\",\"bundle\":\"sha256:00ff\",\"config\":{\"module_state\":\"warm\",\"heartbeat_ms\":1000,\"max_message\":536870912}}"
    },
    {
      "case": "welcome-reject",
      "title": "the engine rejects a harness",
      "message": {
        "t": "welcome",
        "proto": 1,
        "engine": "(devel)",
        "bundle": "sha256:00ff",
        "reject": {
          "code": "runtime_mismatch",
          "message": "runtime \"1.4.2\", the bundle pins \"1.3.10\""
        }
      },
      "payload": "{\"t\":\"welcome\",\"proto\":1,\"engine\":\"(devel)\",\"bundle\":\"sha256:00ff\",\"reject\":{\"code\":\"runtime_mismatch\",\"message\":\"runtime \\\"1.4.2\\\", the bundle pins \\\"1.3.10\\\"\"}}"
    },
    {
      "case": "invoke",
      "title": "run one step; env keys sorted",
      "message": {
        "t": "invoke",
        "id": "i1",
        "run": "r1",
        "site": "m:a",
        "script": "echo",
        "entry": "main",
        "args": {
          "x": [
            1,
            2
          ],
          "y": {
            "z": null
          }
        },
        "env": {
          "WM_JOB_ID": "j1",
          "WM_FLOW_STEP_ID": "a"
        },
        "boundary": "bun"
      },
      "payload": "{\"t\":\"invoke\",\"id\":\"i1\",\"run\":\"r1\",\"site\":\"m:a\",\"script\":\"echo\",\"entry\":\"main\",\"args\":{\"x\":[1,2],\"y\":{\"z\":null}},\"env\":{\"WM_FLOW_STEP_ID\":\"a\",\"WM_JOB_ID\":\"j1\"},\"boundary\":\"bun\"}"
    },
    {
      "case": "invoke-env-escaping",
      "title": "env values with every escape class",
      "message": {
        "t": "invoke",
        "id": "i2",
        "run": "r1",
        "site": "m:a",
        "script": "echo",
        "entry": "main",
        "args": {},
        "env": {
          "A": "quote\" backslash\\ bs\b ff\f nl\n cr\r tab\t ctl\u0001\u001f del eé emoji😀 ls\u2028"
        },
        "boundary": "bun"
      },
      "payload": "{\"t\":\"invoke\",\"id\":\"i2\",\"run\":\"r1\",\"site\":\"m:a\",\"script\":\"echo\",\"entry\":\"main\",\"args\":{},\"env\":{\"A\":\"quote\\\" backslash\\\\ bs\\b ff\\f nl\\n cr\\r tab\\t ctl\\u0001\\u001f del eé emoji😀 ls\u2028\"},\"boundary\":\"bun\"}"
    },
