{
  "case": "echo",
  "title": "an echo step; the result is the step's own JSON text, integer-like keys first as JavaScript orders them",
  "provenance": "policy",
  "relies_on": [
    "WR-9",
    "WR-10"
  ],
  "design": "docs/design/0004-harness-protocol.md#messages",
  "steps": [
    {
      "expect": {
        "t": "hello",
        "proto": 1,
        "harness": {
          "kind": "bun",
          "version": "dev"
        },
        "runtime": "1.3.10",
        "caps": {
          "fetch": true,
          "native": true,
          "fresh": true,
          "host": false
        },
        "bundle": "<bundle>",
        "pid": "<pid>"
      }
    },
    {
      "send": {
        "t": "welcome",
        "proto": 1,
        "engine": "exchange-test",
        "bundle": "<bundle>",
        "config": {
          "module_state": "warm",
          "heartbeat_ms": 60000,
          "max_message": 536870912
        }
      }
    },
    {
      "send": {
        "t": "invoke",
        "id": "i1",
        "run": "r1",
        "site": "m:a",
        "script": "echo",
        "entry": "main",
        "args": {
          "value": {
            "b": [
              1,
              2
            ],
            "a": {
              "x": null
            },
            "1": "one"
          }
        },
        "env": {
          "WM_FLOW_STEP_ID": "a"
        },
        "boundary": "bun"
      }
    },
    {
      "expect": {
        "t": "result",
        "id": "i1",
        "outcome": "ok",
        "body": {
          "1": "one",
          "b": [
            1,
            2
          ],
          "a": {
            "x": null
          }
        },
        "settled": true
      }
    },
    {
      "send": {
        "t": "drain"
      }
    },
    {
      "expect": {
        "t": "bye"
      }
    },
    {
      "exit": 0
    }
  ]
}
