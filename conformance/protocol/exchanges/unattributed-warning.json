{
  "case": "unattributed-warning",
  "title": "a rejection no invocation's context owns fails nothing: every invocation in flight gets a warning frame, in the order they arrived, and both go on (ADR 0004, the shared-process failure model, item 3)",
  "provenance": "policy",
  "relies_on": [],
  "design": "docs/design/0004-harness-protocol.md#the-shared-process-failure-model",
  "steps": [
    {
      "expect": {
        "t": "hello",
        "proto": 1,
        "harness": {
          "kind": "bun",
          "version": "0.0.0-c1"
        },
        "runtime": "1.3.10",
        "caps": {
          "fetch": true,
          "native": true,
          "fresh": false,
          "host": false
        },
        "bundle": "<bundle>",
        "pid": "<pid>"
      }
    },
    {
      "send": {
        "t": "welcome",
        "proto": 1,
        "engine": "exchange-test",
        "bundle": "<bundle>",
        "config": {
          "module_state": "warm",
          "heartbeat_ms": 60000,
          "max_message": 536870912
        }
      }
    },
    {
      "send": {
        "t": "invoke",
        "id": "i1",
        "run": "r1",
        "site": "m:a",
        "script": "sleep",
        "entry": "main",
        "args": {
          "ms": 300
        },
        "env": {
          "WM_FLOW_STEP_ID": "a"
        },
        "boundary": "bun"
      }
    },
    {
      "send": {
        "t": "invoke",
        "id": "i2",
        "run": "r1",
        "site": "m:a",
        "script": "detached-reject",
        "entry": "main",
        "args": {
          "ms": 20
        },
        "env": {
          "WM_FLOW_STEP_ID": "a"
        },
        "boundary": "bun"
      }
    },
    {
      "expect": {
        "t": "warning",
        "id": "i1",
        "code": "unattributed_error",
        "message": "<string>"
      }
    },
    {
      "expect": {
        "t": "warning",
        "id": "i2",
        "code": "unattributed_error",
        "message": "<string>"
      }
    },
    {
      "expect": {
        "t": "result",
        "id": "i1",
        "outcome": "ok",
        "body": 300,
        "settled": true
      }
    },
    {
      "send": {
        "t": "ping",
        "id": "e1"
      }
    },
    {
      "expect": {
        "t": "pong",
        "id": "e1",
        "in_flight": 1,
        "abandoned": 0,
        "errors": 1,
        "lag_ms": "<int>",
        "rss": "<int>"
      }
    },
    {
      "send": {
        "t": "cancel",
        "id": "i2",
        "reason": "canceled"
      }
    },
    {
      "send": {
        "t": "drain"
      }
    },
    {
      "expect": {
        "t": "bye"
      }
    },
    {
      "exit": 0
    }
  ]
}
