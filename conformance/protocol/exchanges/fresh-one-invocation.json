{
  "case": "fresh-one-invocation",
  "title": "a fresh process serves one invocation: a second invoke is a protocol error",
  "provenance": "policy",
  "relies_on": [
    "WR-1"
  ],
  "design": "docs/design/0006-module-state.md",
  "steps": [
    {
      "expect": {
        "t": "hello",
        "proto": 1,
        "harness": {
          "kind": "bun",
          "version": "0.0.0-c1"
        },
        "runtime": "1.3.10",
        "caps": {
          "fetch": true,
          "native": false,
          "fresh": true,
          "host": false
        },
        "bundle": "<bundle>",
        "pid": "<pid>"
      }
    },
    {
      "send": {
        "t": "welcome",
        "proto": 1,
        "engine": "exchange-test",
        "bundle": "<bundle>",
        "config": {
          "module_state": "fresh",
          "heartbeat_ms": 60000,
          "max_message": 536870912
        }
      }
    },
    {
      "send": {
        "t": "invoke",
        "id": "i1",
        "run": "r1",
        "site": "m:a",
        "script": "gate",
        "entry": "main",
        "args": {
          "started": "i1.started",
          "release": "i1.release"
        },
        "env": {
          "WM_FLOW_STEP_ID": "a"
        },
        "boundary": "bun"
      }
    },
    {
      "send": {
        "t": "invoke",
        "id": "i2",
        "run": "r1",
        "site": "m:a",
        "script": "echo",
        "entry": "main",
        "args": {
          "value": 1
        },
        "env": {
          "WM_FLOW_STEP_ID": "a"
        },
        "boundary": "bun"
      }
    },
    {
      "exit": 3
    }
  ]
}
