{
  "case": "heartbeat",
  "title": "the harness pings on its own every heartbeat_ms, with its health, until it handles a drain, which may come after one more ping",
  "provenance": "policy",
  "relies_on": [],
  "design": "docs/design/0004-harness-protocol.md#host-mode",
  "steps": [
    {
      "expect": {
        "t": "hello",
        "proto": 1,
        "harness": {
          "kind": "bun",
          "version": "0.0.0-c1"
        },
        "runtime": "1.3.10",
        "caps": {
          "fetch": true,
          "native": true,
          "fresh": true,
          "host": false
        },
        "bundle": "<bundle>",
        "pid": "<pid>"
      }
    },
    {
      "send": {
        "t": "welcome",
        "proto": 1,
        "engine": "exchange-test",
        "bundle": "<bundle>",
        "config": {
          "module_state": "warm",
          "heartbeat_ms": 50,
          "max_message": 536870912
        }
      }
    },
    {
      "expect": {
        "t": "ping",
        "id": "h1",
        "in_flight": 0,
        "abandoned": 0,
        "errors": 0,
        "lag_ms": "<int>",
        "rss": "<int>"
      },
      "within_ms": 2000
    },
    {
      "expect": {
        "t": "ping",
        "id": "h2",
        "in_flight": 0,
        "abandoned": 0,
        "errors": 0,
        "lag_ms": "<int>",
        "rss": "<int>"
      },
      "within_ms": 2000
    },
    {
      "send": {
        "t": "drain"
      }
    },
    {
      "expect": {
        "t": "bye"
      },
      "ignore": [
        "ping"
      ]
    },
    {
      "exit": 0
    }
  ]
}
