{
  "case": "exit-from-timer",
  "title": "process.exit from a timer of a pending call keeps the invocation's context: it fixes that invocation's outcome, its exit code modulo 256, and the process lives on; the call never ends, so it does not settle (D11)",
  "provenance": "policy",
  "relies_on": [
    "WR-4"
  ],
  "design": "docs/design/0004-harness-protocol.md#the-shared-process-failure-model",
  "steps": [
    {
      "expect": {
        "t": "hello",
        "proto": 1,
        "harness": {
          "kind": "bun",
          "version": "0.0.0-c1"
        },
        "runtime": "1.3.10",
        "caps": {
          "fetch": true,
          "native": false,
          "fresh": false,
          "host": false
        },
        "bundle": "<bundle>",
        "pid": "<pid>"
      }
    },
    {
      "send": {
        "t": "welcome",
        "proto": 1,
        "engine": "exchange-test",
        "bundle": "<bundle>",
        "config": {
          "module_state": "warm",
          "heartbeat_ms": 60000,
          "max_message": 536870912
        }
      }
    },
    {
      "send": {
        "t": "invoke",
        "id": "i1",
        "run": "r1",
        "site": "m:a",
        "script": "exit",
        "entry": "main",
        "args": {
          "ms": 20,
          "code": 258
        },
        "env": {
          "WM_FLOW_STEP_ID": "a"
        },
        "boundary": "bun"
      }
    },
    {
      "expect": {
        "t": "result",
        "id": "i1",
        "outcome": "escaped",
        "tail": "",
        "exit_code": 2,
        "settled": false
      }
    },
    {
      "send": {
        "t": "invoke",
        "id": "i2",
        "run": "r1",
        "site": "m:a",
        "script": "sleep",
        "entry": "main",
        "args": {
          "ms": 10
        },
        "env": {
          "WM_FLOW_STEP_ID": "a"
        },
        "boundary": "bun"
      }
    },
    {
      "expect": {
        "t": "result",
        "id": "i2",
        "outcome": "ok",
        "body": 10,
        "settled": true
      }
    },
    {
      "send": {
        "t": "drain"
      }
    },
    {
      "expect": {
        "t": "bye"
      }
    },
    {
      "exit": 0
    }
  ]
}
