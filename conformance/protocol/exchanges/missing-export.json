{
  "case": "missing-export",
  "title": "an export that is missing fails the step after the module loaded",
  "provenance": "policy",
  "relies_on": [
    "WR-12"
  ],
  "design": "docs/design/0004-harness-protocol.md#messages",
  "steps": [
    {
      "expect": {
        "t": "hello",
        "proto": 1,
        "harness": {
          "kind": "bun",
          "version": "0.0.0-c1"
        },
        "runtime": "1.3.10",
        "caps": {
          "fetch": false,
          "native": false,
          "fresh": false,
          "host": false
        },
        "bundle": "<bundle>",
        "pid": "<pid>"
      }
    },
    {
      "send": {
        "t": "welcome",
        "proto": 1,
        "engine": "exchange-test",
        "bundle": "<bundle>",
        "config": {
          "module_state": "warm",
          "heartbeat_ms": 60000,
          "max_message": 536870912
        }
      }
    },
    {
      "send": {
        "t": "invoke",
        "id": "i1",
        "run": "r1",
        "site": "m:a",
        "script": "no-main",
        "entry": "main",
        "args": {},
        "env": {
          "WM_FLOW_STEP_ID": "a"
        },
        "boundary": "bun"
      }
    },
    {
      "expect": {
        "t": "result",
        "id": "i1",
        "outcome": "error",
        "body": {
          "message": "main function is missing",
          "name": "Error",
          "stack": "<string>"
        },
        "settled": true
      }
    },
    {
      "send": {
        "t": "invoke",
        "id": "i2",
        "run": "r1",
        "site": "m:a",
        "script": "echo",
        "entry": "alternate",
        "args": {},
        "env": {
          "WM_FLOW_STEP_ID": "a"
        },
        "boundary": "bun"
      }
    },
    {
      "expect": {
        "t": "result",
        "id": "i2",
        "outcome": "error",
        "body": {
          "message": "alternate function is missing",
          "name": "Error",
          "stack": "<string>"
        },
        "settled": true
      }
    },
    {
      "send": {
        "t": "drain"
      }
    },
    {
      "expect": {
        "t": "bye"
      }
    },
    {
      "exit": 0
    }
  ]
}
