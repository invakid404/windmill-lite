{
  "case": "reject",
  "title": "a rejected harness exits with code 2 and sends nothing more",
  "provenance": "policy",
  "relies_on": [],
  "design": "docs/design/0004-harness-protocol.md#lifecycle",
  "steps": [
    {
      "expect": {
        "t": "hello",
        "proto": 1,
        "harness": {
          "kind": "bun",
          "version": "0.0.0-c1"
        },
        "runtime": "1.3.10",
        "caps": {
          "fetch": true,
          "native": true,
          "fresh": true,
          "host": false
        },
        "bundle": "<bundle>",
        "pid": "<pid>"
      }
    },
    {
      "send": {
        "t": "welcome",
        "proto": 1,
        "engine": "exchange-test",
        "bundle": "<bundle>",
        "reject": {
          "code": "runtime_mismatch",
          "message": "runtime \"1.3.10\", the bundle pins \"9.9.9\""
        }
      }
    },
    {
      "exit": 2
    }
  ]
}
