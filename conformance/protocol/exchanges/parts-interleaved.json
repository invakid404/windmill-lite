{
  "case": "parts-interleaved",
  "title": "a whole frame between the parts of a message is handled first",
  "provenance": "policy",
  "relies_on": [],
  "design": "docs/design/0004-harness-protocol.md#transport-and-framing",
  "steps": [
    {
      "expect": {
        "t": "hello",
        "proto": 1,
        "harness": {
          "kind": "bun",
          "version": "0.0.0-c1"
        },
        "runtime": "1.3.10",
        "caps": {
          "fetch": true,
          "native": true,
          "fresh": false,
          "host": false
        },
        "bundle": "<bundle>",
        "pid": "<pid>"
      }
    },
    {
      "send": {
        "t": "welcome",
        "proto": 1,
        "engine": "exchange-test",
        "bundle": "<bundle>",
        "config": {
          "module_state": "warm",
          "heartbeat_ms": 60000,
          "max_message": 536870912
        }
      }
    },
    {
      "send": {
        "t": "invoke",
        "id": "i1",
        "run": "r1",
        "site": "m:a",
        "script": "echo",
        "entry": "main",
        "args": {
          "value": {
            "padding": "0123456789012345678901234567890123456789"
          }
        },
        "env": {
          "WM_FLOW_STEP_ID": "a"
        },
        "boundary": "bun"
      },
      "split": {
        "chunk_bytes": 40,
        "after": 1,
        "between": {
          "t": "ping",
          "id": "e1"
        }
      }
    },
    {
      "expect": {
        "t": "pong",
        "id": "e1",
        "in_flight": 0,
        "abandoned": 0,
        "errors": 0,
        "lag_ms": "<int>",
        "rss": "<int>"
      }
    },
    {
      "expect": {
        "t": "result",
        "id": "i1",
        "outcome": "ok",
        "body": {
          "padding": "0123456789012345678901234567890123456789"
        },
        "settled": true
      }
    },
    {
      "send": {
        "t": "drain"
      }
    },
    {
      "expect": {
        "t": "bye"
      }
    },
    {
      "exit": 0
    }
  ]
}
