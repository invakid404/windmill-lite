{
  "case": "cancel-error-late",
  "title": "an abandoned call that throws settles with a late error",
  "provenance": "policy",
  "relies_on": [],
  "design": "docs/design/0004-harness-protocol.md#cancellation-and-deadlines",
  "steps": [
    {
      "expect": {
        "t": "hello",
        "proto": 1,
        "harness": {
          "kind": "bun",
          "version": "0.0.0-c1"
        },
        "runtime": "1.3.10",
        "caps": {
          "fetch": false,
          "native": false,
          "fresh": false,
          "host": false
        },
        "bundle": "<bundle>",
        "pid": "<pid>"
      }
    },
    {
      "send": {
        "t": "welcome",
        "proto": 1,
        "engine": "exchange-test",
        "bundle": "<bundle>",
        "config": {
          "module_state": "warm",
          "heartbeat_ms": 60000,
          "max_message": 536870912
        }
      }
    },
    {
      "send": {
        "t": "invoke",
        "id": "i1",
        "run": "r1",
        "site": "m:a",
        "script": "gate",
        "entry": "main",
        "args": {
          "started": "i1.started",
          "release": "i1.release",
          "message": "after cancel"
        },
        "env": {
          "WM_FLOW_STEP_ID": "a"
        },
        "boundary": "bun"
      }
    },
    {
      "send": {
        "t": "cancel",
        "id": "i1",
        "reason": "canceled"
      }
    },
    {
      "send": {
        "t": "ping",
        "id": "e1"
      }
    },
    {
      "expect": {
        "t": "pong",
        "id": "e1",
        "in_flight": 0,
        "abandoned": 1,
        "errors": 0,
        "lag_ms": "<int>",
        "rss": "<int>"
      }
    },
    {
      "release": "i1.release"
    },
    {
      "expect": {
        "t": "late",
        "id": "i1",
        "kind": "error",
        "body": {
          "message": "after cancel",
          "name": "Error",
          "stack": "<string>"
        },
        "settled": true
      }
    },
    {
      "send": {
        "t": "drain"
      }
    },
    {
      "expect": {
        "t": "bye"
      }
    },
    {
      "exit": 0
    }
  ]
}
