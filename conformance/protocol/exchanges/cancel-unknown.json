{
  "case": "cancel-unknown",
  "title": "a cancel for an invocation that is not in flight changes nothing",
  "provenance": "policy",
  "relies_on": [],
  "design": "docs/design/0004-harness-protocol.md#cancellation-and-deadlines",
  "steps": [
    {
      "expect": {
        "t": "hello",
        "proto": 1,
        "harness": {
          "kind": "bun",
          "version": "dev"
        },
        "runtime": "1.3.10",
        "caps": {
          "fetch": true,
          "native": true,
          "fresh": true,
          "host": false
        },
        "bundle": "<bundle>",
        "pid": "<pid>"
      }
    },
    {
      "send": {
        "t": "welcome",
        "proto": 1,
        "engine": "exchange-test",
        "bundle": "<bundle>",
        "config": {
          "module_state": "warm",
          "heartbeat_ms": 60000,
          "max_message": 536870912
        }
      }
    },
    {
      "send": {
        "t": "invoke",
        "id": "i1",
        "run": "r1",
        "site": "m:a",
        "script": "echo",
        "entry": "main",
        "args": {
          "value": {}
        },
        "env": {
          "WM_FLOW_STEP_ID": "a"
        },
        "boundary": "bun"
      }
    },
    {
      "expect": {
        "t": "result",
        "id": "i1",
        "outcome": "ok",
        "body": {},
        "settled": true
      }
    },
    {
      "send": {
        "t": "cancel",
        "id": "i1",
        "reason": "run_ended"
      }
    },
    {
      "send": {
        "t": "cancel",
        "id": "never-sent",
        "reason": "run_ended"
      }
    },
    {
      "quiet_ms": 200
    },
    {
      "send": {
        "t": "ping",
        "id": "e1"
      }
    },
    {
      "expect": {
        "t": "pong",
        "id": "e1",
        "in_flight": 0,
        "abandoned": 0,
        "errors": 0,
        "lag_ms": "<int>",
        "rss": "<int>"
      }
    },
    {
      "send": {
        "t": "drain"
      }
    },
    {
      "expect": {
        "t": "bye"
      }
    },
    {
      "exit": 0
    }
  ]
}
