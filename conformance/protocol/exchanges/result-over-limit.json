{
  "case": "result-over-limit",
  "title": "a result larger than a lowered message limit ends its invocation with the largest escaped frame that fits: here, with a 370-character id, one without a tail",
  "provenance": "policy",
  "relies_on": [
    "WR-15",
    "WR-20"
  ],
  "design": "docs/design/0004-harness-protocol.md#transport-and-framing",
  "steps": [
    {
      "expect": {
        "t": "hello",
        "proto": 1,
        "harness": {
          "kind": "bun",
          "version": "0.0.0-c1"
        },
        "runtime": "1.3.10",
        "caps": {
          "fetch": true,
          "native": true,
          "fresh": false,
          "host": false
        },
        "bundle": "<bundle>",
        "pid": "<pid>"
      }
    },
    {
      "send": {
        "t": "welcome",
        "proto": 1,
        "engine": "exchange-test",
        "bundle": "<bundle>",
        "config": {
          "module_state": "warm",
          "heartbeat_ms": 60000,
          "max_message": 512
        }
      }
    },
    {
      "send": {
        "t": "invoke",
        "id": "",
        "run": "r",
        "site": "m:a",
        "script": "big",
        "entry": "main",
        "args": {
          "bytes": 1000
        },
        "env": {},
        "boundary": "bun"
      }
    },
    {
      "expect": {
        "t": "result",
        "id": "<i*370>",
        "outcome": "escaped",
        "tail": "",
        "exit_code": 1,
        "settled": true
      }
    },
    {
      "send": {
        "t": "invoke",
        "id": "i2",
        "run": "r",
        "site": "m:a",
        "script": "echo",
        "entry": "main",
        "args": {
          "value": {
            "still": "up"
          }
        },
        "env": {},
        "boundary": "bun"
      }
    },
    {
      "expect": {
        "t": "result",
        "id": "i2",
        "outcome": "ok",
        "body": {
          "still": "up"
        },
        "settled": true
      }
    },
    {
      "send": {
        "t": "drain"
      }
    },
    {
      "expect": {
        "t": "bye"
      }
    },
    {
      "exit": 0
    }
  ]
}
