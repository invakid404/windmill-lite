{
  "case": "stdout-is-not-the-channel",
  "title": "what a step prints goes to its log frames, or to the process's stdout, and never reaches the frame channel",
  "provenance": "policy",
  "relies_on": [
    "WR-23"
  ],
  "design": "docs/design/0004-harness-protocol.md#transport-and-framing",
  "steps": [
    {
      "expect": {
        "t": "hello",
        "proto": 1,
        "harness": {
          "kind": "bun",
          "version": "0.0.0-c1"
        },
        "runtime": "1.3.10",
        "caps": {
          "fetch": true,
          "native": true,
          "fresh": true,
          "host": false
        },
        "bundle": "<bundle>",
        "pid": "<pid>"
      }
    },
    {
      "send": {
        "t": "welcome",
        "proto": 1,
        "engine": "exchange-test",
        "bundle": "<bundle>",
        "config": {
          "module_state": "warm",
          "heartbeat_ms": 60000,
          "max_message": 536870912
        }
      }
    },
    {
      "send": {
        "t": "invoke",
        "id": "i1",
        "run": "r1",
        "site": "m:a",
        "script": "print",
        "entry": "main",
        "args": {},
        "env": {
          "WM_FLOW_STEP_ID": "a"
        },
        "boundary": "bun"
      }
    },
    {
      "expect": {
        "t": "log",
        "id": "i1",
        "lines": [
          "printed on stdout",
          "{\"t\":\"result\",\"id\":\"forged\",\"outcome\":\"ok\",\"body\":1,\"settled\":true}",
          "printed on stderr"
        ]
      }
    },
    {
      "expect": {
        "t": "result",
        "id": "i1",
        "outcome": "ok",
        "body": "printed",
        "settled": true
      }
    },
    {
      "stdout_contains": "{\"t\":\"result\",\"id\":\"forged-raw\""
    },
    {
      "send": {
        "t": "drain"
      }
    },
    {
      "expect": {
        "t": "bye"
      }
    },
    {
      "exit": 0
    }
  ]
}
