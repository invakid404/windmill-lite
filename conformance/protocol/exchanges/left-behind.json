{
  "case": "left-behind",
  "title": "what an invocation still has when it settles is reported in a left_behind warning ahead of its result, and then revoked: none of it fires",
  "provenance": "policy",
  "relies_on": [
    "WR-2"
  ],
  "design": "docs/design/0004-harness-protocol.md#the-shared-process-failure-model",
  "steps": [
    {
      "expect": {
        "t": "hello",
        "proto": 1,
        "harness": {
          "kind": "bun",
          "version": "0.0.0-c1"
        },
        "runtime": "1.3.10",
        "caps": {
          "fetch": true,
          "native": true,
          "fresh": true,
          "host": false
        },
        "bundle": "<bundle>",
        "pid": "<pid>"
      }
    },
    {
      "send": {
        "t": "welcome",
        "proto": 1,
        "engine": "exchange-test",
        "bundle": "<bundle>",
        "config": {
          "module_state": "warm",
          "heartbeat_ms": 60000,
          "max_message": 536870912
        }
      }
    },
    {
      "send": {
        "t": "invoke",
        "id": "i1",
        "run": "r1",
        "site": "m:a",
        "script": "leave-work",
        "entry": "main",
        "args": {
          "ms": 20
        },
        "env": {
          "WM_FLOW_STEP_ID": "a"
        },
        "boundary": "bun"
      }
    },
    {
      "expect": {
        "t": "warning",
        "id": "i1",
        "code": "left_behind",
        "message": "left at settlement: 1 immediate, 1 interval, 1 timeout",
        "left": {
          "immediate": 1,
          "interval": 1,
          "timeout": 1
        }
      }
    },
    {
      "expect": {
        "t": "result",
        "id": "i1",
        "outcome": "ok",
        "body": "done",
        "settled": true
      }
    },
    {
      "quiet_ms": 200
    },
    {
      "send": {
        "t": "drain"
      }
    },
    {
      "expect": {
        "t": "bye"
      }
    },
    {
      "exit": 0
    }
  ]
}
