{
  "case": "platform-after-settlement",
  "title": "a platform call that an invocation's work makes after it settled is refused, and never reaches the engine",
  "provenance": "policy",
  "relies_on": [
    "WR-2"
  ],
  "design": "docs/design/0004-harness-protocol.md#per-invocation-identity-logs-and-environment",
  "steps": [
    {
      "expect": {
        "t": "hello",
        "proto": 1,
        "harness": {
          "kind": "bun",
          "version": "0.0.0-c1"
        },
        "runtime": "1.3.10",
        "caps": {
          "fetch": true,
          "native": true,
          "fresh": true,
          "host": false
        },
        "bundle": "<bundle>",
        "pid": "<pid>"
      }
    },
    {
      "send": {
        "t": "welcome",
        "proto": 1,
        "engine": "exchange-test",
        "bundle": "<bundle>",
        "config": {
          "module_state": "warm",
          "heartbeat_ms": 60000,
          "max_message": 536870912,
          "facade": "http://127.0.0.1:9"
        }
      }
    },
    {
      "send": {
        "t": "invoke",
        "id": "i1",
        "run": "r1",
        "site": "m:a",
        "script": "late-platform",
        "entry": "main",
        "args": {
          "ms": 20
        },
        "env": {
          "BASE_URL": "http://127.0.0.1:9",
          "WM_FLOW_STEP_ID": "a"
        },
        "boundary": "bun"
      }
    },
    {
      "expect": {
        "t": "result",
        "id": "i1",
        "outcome": "ok",
        "body": "done",
        "settled": true
      }
    },
    {
      "expect": {
        "t": "late",
        "id": "i1",
        "kind": "error",
        "body": {
          "message": "windmill-lite: the invocation has settled, so its platform calls are refused",
          "name": "TypeError",
          "stack": "<string>",
          "step_id": "a"
        },
        "settled": false
      }
    },
    {
      "send": {
        "t": "drain"
      }
    },
    {
      "expect": {
        "t": "bye"
      }
    },
    {
      "exit": 0
    }
  ]
}
