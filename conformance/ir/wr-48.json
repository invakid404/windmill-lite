    {
      "spec": "WR-48",
      "variant": "string-zero",
      "provenance": "policy",
      "policy": "0001 §5a",
      "title": "the string \"0\" is truthy, so customBundler is set and refused",
      "note": "Running the command (WR-48/a) is later; a set customBundler is refused as SY-8's custom-bundler case is.",
      "given": {
        "files": {
          "wmill.yaml": "defaultTs: bun\ncodebases:\n  - relative_path: .\n    customBundler: \"0\"\n",
          "f/x/s.ts": "export async function main() { return 1 }\n"
        },
        "contract": "roots:\n  - script: f/x/s\n"
      },
      "expect": {
        "errors": [
          {
            "kind": "unsupported_feature",
            "contains": [
              "script f/x/s",
              "unsupported: customBundler (codebase entry 0)"
            ]
          }
        ]
      }
    },
    {
      "spec": "WR-48",
      "variant": "true",
      "provenance": "policy",
      "policy": "0001 §5a",
      "title": "customBundler: true is set, and refused",
      "note": "On Windmill true becomes the shell command true, which prints nothing, so the bundle is empty (WR-48); windmill-lite refuses it.",
      "given": {
        "files": {
          "wmill.yaml": "defaultTs: bun\ncodebases:\n  - relative_path: .\n    customBundler: true\n",
          "f/x/s.ts": "export async function main() { return 1 }\n"
        },
        "contract": "roots:\n  - script: f/x/s\n"
      },
      "expect": {
        "errors": [
          {
            "kind": "unsupported_feature",
            "contains": [
              "script f/x/s",
              "unsupported: customBundler (codebase entry 0)"
            ]
          }
        ]
      }
    }
  ],
  "note": "Which customBundler values count as set (WR-48, later): JavaScript-truthy ones. An unset one leaves the script a codebase script that esbuild builds (C2b); a set one is refused, since windmill-lite does not run the command (WR-48/a, deferred)."
}
