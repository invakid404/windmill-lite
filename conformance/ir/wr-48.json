{
  "finding": "WR-48",
  "cases": [
    {
      "spec": "WR-48/b",
      "provenance": "source-derived",
      "title": "a falsy customBundler counts as unset",
      "note": "The CLI tests customBundler for JavaScript truthiness, so false leaves esbuild in charge, as with no key; conformance/build/wr-48.json builds and runs the script.",
      "given": {
        "files": {
          "wmill.yaml": "defaultTs: bun\ncodebases:\n  - relative_path: .\n    customBundler: false\n",
          "f/x/s.ts": "export async function main() { return 1 }\n"
        },
        "contract": "roots:\n  - script: f/x/s\n"
      },
      "expect": {
        "scripts": {
          "f/x/s": {
            "at": {
              "/bundling": "codebase",
              "/codebase": {
                "index": 0,
                "relative_path": ".",
                "format": "cjs"
              },
              "/dependency_set": "codebase:0"
            }
          }
        }
      }
    },
    {
      "spec": "WR-48",
      "variant": "zero",
      "provenance": "source-derived",
      "title": "customBundler: 0 counts as unset",
