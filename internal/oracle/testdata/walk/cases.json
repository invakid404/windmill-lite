        "skipped": true
       },
       {
        "type": "WaitingForPriorSteps",
        "id": "b"
       }
      ],
      "failure_module": {
       "type": "WaitingForPriorSteps",
       "id": "failure"
      }
     },
     "args": {},
     "result": 1,
