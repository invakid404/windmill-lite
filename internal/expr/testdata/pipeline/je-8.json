      "site": "input_transform",
      "text": "(results.a)",
      "expect": {
        "shortcut": {},
        "binds": ["result", "results"],
        "code": "((await results.a))",
        "route": "engine",
        "bound": {"previous_result": "{\"n\": 12345678901234567890}"},
        "results_lookup": true
      }
    },
