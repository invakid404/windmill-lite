    {
      "spec": "JE-8/a",
      "provenance": "oracle-observed",
      "title": "results.<previous id> returns previous_result's text verbatim",
      "recorded": {"fixture": "je/shortcuts", "run": "je8-a", "at": "m:b", "input": "x"},
      "site": "input_transform",
      "text": "results.a",
      "expect": {
        "shortcut": {"previous_id": "a", "results_path": {"step": "a"}},
        "mode": "expression",
        "binds": ["result", "results"],
        "code": "(await results.a)",
        "route": "previous_id",
        "text": "{\"n\": 12345678901234567890}"
      }
    },
    {
      "spec": "JE-8/b",
      "provenance": "oracle-observed",
