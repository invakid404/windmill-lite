        "code": "(await results.l)[1]",
        "route": "results_path",
        "text": "20"
      }
    },
    {
      "spec": "JE-9/f",
      "provenance": "oracle-observed",
      "title": "a non-numeric first element on a loop gives null",
      "recorded": {"fixture": "je/loops", "run": "je9-ef", "at": "m:b_f", "input": "x"},
      "site": "input_transform",
      "text": "results.l.foo",
      "expect": {"shortcut": {"previous_id": "l.foo", "results_path": {"step": "l", "segments": ["foo"]}}, "route": "results_path", "text": "null"}
    },
    {
      "spec": "JE-9/g",
      "provenance": "oracle-observed",
      "title": "a matching first line discards the rest",
      "recorded": {"fixture": "je/shortcuts", "run": "je9-g", "at": "m:b", "input": "x"},
      "site": "input_transform",
      "text": "results.a\n+ 100",
      "expect": {
        "shortcut": {"previous_id": "a\n+ 100", "results_path": {"step": "a"}},
        "code": "(await results.a)\n+ 100",
        "route": "results_path",
        "text": "7"
      }
    },
    {
      "spec": "JE-9/h",
      "provenance": "oracle-observed",
      "title": "a later matching line also fires the shortcut",
      "recorded": {"fixture": "je/shortcuts", "run": "je9-h", "at": "m:b", "input": "x"},
      "site": "input_transform",
      "text": "100 +\nresults.a",
      "expect": {"shortcut": {"results_path": {"step": "a"}}, "route": "results_path", "text": "7"}
    },
    {
      "spec": "JE-9/i",
      "provenance": "oracle-observed",
      "title": "an indented line never qualifies",
      "recorded": {"fixture": "je/shortcuts", "run": "je9-i", "at": "m:b", "input": "x"},
      "site": "input_transform",
      "text": "100 +\n  results.a",
      "expect": {"shortcut": {}, "code": "100 +\n  (await results.a)", "route": "engine", "results_lookup": true}
