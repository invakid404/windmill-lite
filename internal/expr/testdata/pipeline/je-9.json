{
  "finding": "JE-9",
  "cases": [
    {
      "spec": "JE-9/a",
      "provenance": "oracle-observed",
      "title": "a null intermediate gives null",
      "recorded": {"fixture": "je/shortcuts", "run": "je9-a", "at": "m:b", "input": "x"},
      "site": "input_transform",
      "text": "results.a.b.c",
      "expect": {
        "shortcut": {"previous_id": "a.b.c", "results_path": {"step": "a", "segments": ["b", "c"]}},
        "route": "results_path",
        "text": "null"
      }
    },
    {
      "spec": "JE-9/b",
      "provenance": "oracle-observed",
      "title": "the same path in parentheses reaches the engine",
      "recorded": {"fixture": "je/shortcuts", "run": "je9-b", "at": "m:b", "input": "x"},
      "site": "input_transform",
      "text": "(results.a.b.c)",
      "expect": {"shortcut": {}, "code": "((await results.a).b.c)", "route": "engine", "bound": {}, "results_lookup": true}
    },
    {
      "spec": "JE-9/c",
      "provenance": "oracle-observed",
      "title": "a final .length declines the shortcut",
      "recorded": {"fixture": "je/shortcuts", "run": "je9-c", "at": "m:b", "input": "x"},
      "site": "input_transform",
      "text": "results.a.length",
      "expect": {
        "shortcut": {"previous_id": "a.length", "results_path": {"step": "a", "segments": ["length"], "declines": true}},
        "code": "(await results.a).length",
        "route": "engine",
        "results_lookup": true
      }
    },
    {
      "spec": "JE-9/d",
      "provenance": "oracle-observed",
      "title": "a missing step gives null",
      "recorded": {"fixture": "je/shortcuts", "run": "je9-d", "at": "m:b", "input": "x"},
      "site": "input_transform",
      "text": "results.nope.x",
      "expect": {
        "shortcut": {"previous_id": "nope.x", "results_path": {"step": "nope", "segments": ["x"]}},
        "route": "results_path",
        "text": "null"
      }
    },
    {
      "spec": "JE-9/e",
      "provenance": "oracle-observed",
      "title": "an index selects a loop child's result",
      "recorded": {"fixture": "je/loops", "run": "je9-ef", "at": "m:b_e", "input": "x"},
      "site": "input_transform",
      "text": "results.l[1]",
      "expect": {
