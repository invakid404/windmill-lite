      "want": {
        "status": "success",
        "result": {
          "top": {"job_id": "${u1}"},
          "upper": {"error": {"job_id": "01A1B47F-0FBB-67DE-AAF0-DFC021FCEABE"}},
          "within": {"error": {"job_id": "job ${u2}"}},
          "string": {"error": "${u3}"},
          "array": {"error": [{"job_id": "${u4}"}]},
          "other": {"error": {"id": "${u5}"}},
          "said": "${u1} ${u2} ${u3} ${u4} ${u5}"
        }
      }
    },
    {
      "name": "the order: effects, result, steps by site path, members sorted at every depth",
      "spec": ["OR-14"], "provenance": "policy",
      "raw": {
        "status": "failure",
        "effects": [{"error": {"job_id": "${u1}"}}],
        "result": {
          "z": {"error": {"job_id": "${u2}"}},
          "a": {"error": {"job_id": "${u4}", "cause": {"error": {"job_id": "${u3}"}}}}
        },
        "steps": {
          "m:b": {"status": "failure", "args": {}, "result": {"error": {"job_id": "${u5}", "message": "job ${u1} failed"}}},
          "m:a": {"status": "success", "args": {"x": {"error": {"job_id": "${u6}"}}}, "result": {"error": {"job_id": "${u7}"}, "${u2}": 1}}
