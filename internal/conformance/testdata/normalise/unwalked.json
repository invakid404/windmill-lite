        "status": "failure",
        "effects": [{"error": {"job_id": "<job:?1>"}}],
        "result": {
          "z": {"error": {"job_id": "<job:?4>"}},
          "a": {"error": {"job_id": "<job:?3>", "cause": {"error": {"job_id": "<job:?2>"}}}}
        },
        "steps": {
          "m:b": {"status": "failure", "args": {}, "result": {"error": {"job_id": "<job:?7>", "message": "job <job:?1> failed"}}},
          "m:a": {"status": "success", "args": {"x": {"error": {"job_id": "<job:?5>"}}}, "result": {"error": {"job_id": "<job:?6>"}, "<job:?4>": 1}}
        }
      }
    },
    {
      "name": "members sort by their names with walked ids replaced, not by the raw ids",
      "spec": ["OR-14"], "provenance": "policy",
      "raw": {
        "status": "success",
        "result": {"${a}": {"error": {"job_id": "${u1}"}}, "9": {"error": {"job_id": "${u2}"}}}
      },
      "want": {
        "status": "success",
        "result": {"<job:m:a>": {"error": {"job_id": "<job:?2>"}}, "9": {"error": {"job_id": "<job:?1>"}}}
      }
    },
    {
      "name": "a response body is replaced, and user text that looks like the placeholder is escaped",
      "spec": ["OR-14", "Q-OR-17"], "provenance": "policy",
      "raw": {
        "status": "success",
        "result": {"error": {"job_id": "${u1}"}, "note": "<job:?1> and <${u1}"},
        "response": {"status": 200, "content_type": "application/json", "body": "{\"error\": {\"job_id\": \"${u2}\"}, \"of\": \"${u1}\"}"}
      },
      "want": {
        "status": "success",
        "result": {"error": {"job_id": "<job:?1>"}, "note": "<<job:?1> and <<<job:?1>"},
        "response": {"status": 200, "content_type": "application/json", "body": "{\"error\": {\"job_id\": \"${u2}\"}, \"of\": \"<job:?1>\"}"}
      }
