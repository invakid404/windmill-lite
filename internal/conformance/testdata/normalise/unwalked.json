{
  "about": "Unwalked job ids (OR-14 item 1): each case gives a run's raw observation and its normalised one. In strings, ${name} stands for the id of the walked job named in ids, and ${uN} for an unwalked job's id, which the test draws twice, the second time in the opposite order of value, so both executions must give the same numbers. Only a UUID that is the whole value of job_id in an object under a member error, and no walked job's, is numbered: from 1, in the order of first occurrence over the observation read with sorted members (effects, result, steps by site path), then replaced anywhere as <job:?N>.",
  "ids": {
    "a": {"id": "11111111-aaaa-4aaa-8aaa-aaaaaaaaaaaa", "path": "m:a"},
    "root": {"id": "33333333-cccc-4ccc-8ccc-cccccccccccc", "path": ""}
  },
  "cases": [
    {
      "name": "OR-14/c: the previews' failed steps, numbered in sorted member order",
      "spec": ["OR-14/c"], "provenance": "source-derived",
      "raw": {
        "status": "success",
        "result": {
          "seq": {"success": true, "result": [{"error": {"name": "Error", "job_id": "${u1}", "message": "boom", "step_id": "b", "flow_path": "tmp/main/loop-0"}}, 2]},
          "par": {"success": true, "result": [{"error": {"name": "Error", "job_id": "${u2}", "message": "boom", "step_id": "b", "flow_path": "tmp/main/forloop-0"}}, 2]},
          "ba": {"success": true, "result": [{"error": {"name": "Error", "job_id": "${u3}", "message": "b", "step_id": "f", "flow_path": "tmp/main/branchall-0"}}, 2]}
        },
        "steps": {
          "m:d": {"status": "success", "args": {}, "result": {
            "seq": {"success": true, "result": [{"error": {"name": "Error", "job_id": "${u1}", "message": "boom", "step_id": "b", "flow_path": "tmp/main/loop-0"}}, 2]},
            "par": {"success": true, "result": [{"error": {"name": "Error", "job_id": "${u2}", "message": "boom", "step_id": "b", "flow_path": "tmp/main/forloop-0"}}, 2]},
            "ba": {"success": true, "result": [{"error": {"name": "Error", "job_id": "${u3}", "message": "b", "step_id": "f", "flow_path": "tmp/main/branchall-0"}}, 2]}
          }}
        }
      },
      "want": {
        "status": "success",
        "result": {
          "seq": {"success": true, "result": [{"error": {"name": "Error", "job_id": "<job:?3>", "message": "boom", "step_id": "b", "flow_path": "tmp/main/loop-0"}}, 2]},
          "par": {"success": true, "result": [{"error": {"name": "Error", "job_id": "<job:?2>", "message": "boom", "step_id": "b", "flow_path": "tmp/main/forloop-0"}}, 2]},
          "ba": {"success": true, "result": [{"error": {"name": "Error", "job_id": "<job:?1>", "message": "b", "step_id": "f", "flow_path": "tmp/main/branchall-0"}}, 2]}
        },
        "steps": {
          "m:d": {"status": "success", "args": {}, "result": {
            "seq": {"success": true, "result": [{"error": {"name": "Error", "job_id": "<job:?3>", "message": "boom", "step_id": "b", "flow_path": "tmp/main/loop-0"}}, 2]},
            "par": {"success": true, "result": [{"error": {"name": "Error", "job_id": "<job:?2>", "message": "boom", "step_id": "b", "flow_path": "tmp/main/forloop-0"}}, 2]},
            "ba": {"success": true, "result": [{"error": {"name": "Error", "job_id": "<job:?1>", "message": "b", "step_id": "f", "flow_path": "tmp/main/branchall-0"}}, 2]}
          }}
        }
      }
    },
    {
      "name": "OR-14/c: a walked job's id in the same place keeps its site's placeholder and takes no number",
      "spec": ["OR-14/c"], "provenance": "source-derived",
      "raw": {
        "status": "success",
        "result": {"mine": {"error": {"name": "Error", "job_id": "${a}"}}, "theirs": {"error": {"name": "Error", "job_id": "${u1}"}}}
      },
      "want": {
        "status": "success",
        "result": {"mine": {"error": {"name": "Error", "job_id": "<job:m:a>"}}, "theirs": {"error": {"name": "Error", "job_id": "<job:?1>"}}}
      }
    },
    {
      "name": "OR-14/c: a UUID that no error object's job_id names stays as it is",
