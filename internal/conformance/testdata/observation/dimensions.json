      "base": {
        "status": "failure",
        "result": {"p": {"error": {"name": "EarlyStopError", "message": "E"}}, "r": {"error": {"name": "EarlyStopError", "message": "E"}}, "x": 1},
        "steps": {
          "m:a": {"status": "success", "module": "failure", "args": {}, "result": {"x": 1}, "carried": {"error": {"name": "EarlyStopError", "message": "E"}}},
          "s:failure": {"status": "success", "args": {"p": {"error": {"name": "EarlyStopError", "message": "E"}}, "r": {"error": {"name": "EarlyStopError", "message": "E"}}, "x": 1}, "result": {"p": {"error": {"name": "EarlyStopError", "message": "E"}}, "r": {"error": {"name": "EarlyStopError", "message": "E"}}, "x": 1}}
        }
      },
      "variants": [
        {
          "why": "only the module status differs",
          "steps": {"m:a": {"status": "success", "args": {}, "result": {"x": 1}, "carried": {"error": {"name": "EarlyStopError", "message": "E"}}}}
        },
        {
          "why": "only the carried value differs: it equals the stored result",
          "steps": {"m:a": {"status": "success", "module": "failure", "args": {}, "result": {"x": 1}}}
        },
        {
          "why": "only the carried value differs: another error message",
          "steps": {"m:a": {"status": "success", "module": "failure", "args": {}, "result": {"x": 1}, "carried": {"error": {"name": "EarlyStopError", "message": "F"}}}}
        }
      ]
    },
