{
  "about": "Canonical site-path texts (ADR 0011). Each case builds a path from typed segments and expects its text and its job-id placeholder; the text must parse back to the same segments. Provenance is policy: the encoding is windmill-lite's answer to Q-OR-17, not Windmill behaviour.",
  "cases": [
    {"name": "root", "spec": ["Q-OR-17"], "provenance": "policy", "segments": [], "text": "", "placeholder": "<job:>"},
    {"name": "unique module id", "spec": ["Q-OR-17"], "provenance": "policy", "segments": [{"module": "a"}], "text": "m:a", "placeholder": "<job:m:a>"},
    {"name": "first occurrence of a repeated id", "spec": ["OF-2", "Q-OR-17"], "provenance": "policy", "segments": [{"module": "a", "occurrence": 0}], "text": "m:a~0"},
    {"name": "second occurrence of a repeated id", "spec": ["OF-2", "Q-OR-17"], "provenance": "policy", "segments": [{"module": "a", "occurrence": 1}], "text": "m:a~1"},
    {"name": "iteration", "spec": ["Q-OR-17"], "provenance": "policy", "segments": [{"iteration": 2}], "text": "i:2"},
    {"name": "iteration zero", "spec": ["Q-OR-17"], "provenance": "policy", "segments": [{"iteration": 0}], "text": "i:0"},
    {"name": "indexed branch", "spec": ["Q-OR-17"], "provenance": "policy", "segments": [{"branch": 0}], "text": "b:0"},
    {"name": "default branch", "spec": ["Q-OR-17"], "provenance": "policy", "segments": [{"branch": "default"}], "text": "b:default"},
    {"name": "failure slot", "spec": ["OR-V8/a", "Q-OR-17"], "provenance": "policy", "segments": [{"slot": "failure"}], "text": "s:failure", "placeholder": "<job:s:failure>"},
    {"name": "preprocessor slot", "spec": ["OR-V8/b", "Q-OR-17"], "provenance": "policy", "segments": [{"slot": "preprocessor"}], "text": "s:preprocessor"},
    {"name": "ordinary module named failure", "spec": ["OR-V8/a", "Q-OR-17"], "provenance": "policy", "segments": [{"module": "failure"}], "text": "m:failure", "placeholder": "<job:m:failure>"},
    {"name": "ordinary module named preprocessor", "spec": ["OR-V8/b", "Q-OR-17"], "provenance": "policy", "segments": [{"module": "preprocessor"}], "text": "m:preprocessor"},
    {"name": "failed first attempt", "spec": ["Q-OR-17"], "provenance": "policy", "segments": [{"module": "a"}, {"attempt": 0}], "text": "m:a/r:0"},
    {"name": "nested loops", "spec": ["Q-OR-17"], "provenance": "policy", "segments": [{"module": "outer"}, {"iteration": 1}, {"module": "inner"}, {"iteration": 0}, {"module": "s"}], "text": "m:outer/i:1/m:inner/i:0/m:s", "placeholder": "<job:m:outer/i:1/m:inner/i:0/m:s>"},
    {"name": "id containing %", "spec": ["Q-OR-17"], "provenance": "policy", "segments": [{"module": "a%b"}], "text": "m:a%25b"},
    {"name": "id containing /", "spec": ["OR-V8/c", "Q-OR-17"], "provenance": "policy", "segments": [{"module": "a/b"}], "text": "m:a%2Fb"},
    {"name": "id that spells the escape of /", "spec": ["OR-V8/c", "Q-OR-17"], "provenance": "policy", "segments": [{"module": "a%2Fb"}], "text": "m:a%252Fb"},
    {"name": "id containing :", "spec": ["Q-OR-17"], "provenance": "policy", "segments": [{"module": "a:b"}], "text": "m:a%3Ab"},
    {"name": "id containing ~", "spec": ["Q-OR-17"], "provenance": "policy", "segments": [{"module": "a~b"}], "text": "m:a%7Eb"},
    {"name": "unique id that looks like an occurrence", "spec": ["Q-OR-17"], "provenance": "policy", "segments": [{"module": "a~1"}], "text": "m:a%7E1"},
    {"name": "repeated id that looks like an occurrence", "spec": ["Q-OR-17"], "provenance": "policy", "segments": [{"module": "a~1", "occurrence": 0}], "text": "m:a%7E1~0"},
    {"name": "id made only of escaped characters", "spec": ["Q-OR-17"], "provenance": "policy", "segments": [{"module": "%/:~"}], "text": "m:%25%2F%3A%7E"},
    {"name": "empty id", "spec": ["OF-2", "Q-OR-17"], "provenance": "policy", "segments": [{"module": ""}], "text": "m:"},
    {"name": "empty id repeated", "spec": ["OF-2", "Q-OR-17"], "provenance": "policy", "segments": [{"module": "", "occurrence": 0}], "text": "m:~0"},
    {"name": "non-ASCII id", "spec": ["OF-2", "Q-OR-17"], "provenance": "policy", "segments": [{"module": "é/ü"}], "text": "m:é%2Fü"},
    {"name": "id containing > keeps its placeholder delimited", "spec": ["OR-14", "Q-OR-17"], "provenance": "policy", "segments": [{"module": "a>b"}], "text": "m:a>b", "placeholder": "<job:m:a%3Eb>"},
    {"name": "id containing <job:", "spec": ["OR-14", "Q-OR-17"], "provenance": "policy", "segments": [{"module": "<job:x>"}], "text": "m:<job%3Ax>", "placeholder": "<job:m:<job%3Ax%3E>"},
    {"name": "subflow failure slot", "spec": ["Q-OR-17"], "provenance": "policy", "segments": [{"module": "sub"}, {"slot": "failure"}], "text": "m:sub/s:failure"},
    {"name": "branch body with a retried module", "spec": ["Q-OR-17"], "provenance": "policy", "segments": [{"module": "br"}, {"branch": "default"}, {"module": "x"}, {"attempt": 2}], "text": "m:br/b:default/m:x/r:2"}
  ]
}
